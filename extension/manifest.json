{
  "manifest_version": 3,
  "name": "AI Website Intelligence",
  "description": "Analyze visited websites in real time and display safety, traffic, and reputation insights.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Website Intelligence"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
